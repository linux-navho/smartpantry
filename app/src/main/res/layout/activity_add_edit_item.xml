<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_surface"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        android:elevation="0dp" />

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/toolbar"
        android:background="@color/border_subtle" />

    <!-- Anchored Grounded Bottom Dock with Divider -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/brand_primary"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteItem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_delete"
                android:textSize="14sp"
                android:visibility="gone"
                app:cornerRadius="10dp"
                android:textColor="@color/status_expired_text"
                app:strokeColor="@color/status_expired_border"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarDivider"
        android:layout_above="@id/bottomDock"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Ingredient Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INGREDIENT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_tertiary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutSelectIngredient"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_surface_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedIngredient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select ingredient"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCatalogCategoryHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pantry Staple"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change ▾"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Quantity Hero Counter & Presets -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOCK QUANTITY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_tertiary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <!-- Hero Stepper Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">

                    <!-- Tactile Minus Button -->
                    <TextView
                        android:id="@+id/btnQtyMinus"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/stepper_btn_background"
                        android:gravity="center"
                        android:text="–"
                        android:textSize="26sp"
                        android:textColor="@color/text_primary"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Centered Quantity & Unit -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvQuantityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/text_primary"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoundUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="pcs"
                            android:textColor="@color/brand_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Tactile Plus Button -->
                    <TextView
                        android:id="@+id/btnQtyPlus"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/stepper_btn_background"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_subtle"
                    android:layout_marginBottom="14dp" />

                <!-- Preset Chips Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Presets"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="10dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Card 3: Expiry Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPIRY DATE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_tertiary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_surface_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDisplayExpiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026-10-29"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExpiryRelativeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires in 7 days"
                        android:textSize="12sp"
                        android:textColor="@color/status_fresh_text"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Edit"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
